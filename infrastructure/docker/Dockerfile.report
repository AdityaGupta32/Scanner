# ══════════════════════════════════════════════════════════════
#  Dockerfile.report — OWASP GenAI Report Generator Service
# ══════════════════════════════════════════════════════════════
FROM python:3.11-slim

LABEL maintainer="VerseScan Team"
LABEL description="PDF Audit Report Generator — net_blue zone"
LABEL zone="blue"

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY report_generator.py .
COPY owasp_genai_report.py .
COPY report_service.py .

RUN mkdir -p /app/reports

EXPOSE 9100

RUN useradd -m reporter && chown -R reporter:reporter /app
USER reporter

CMD ["uvicorn", "report_service:app", "--host", "0.0.0.0", "--port", "9100"]
