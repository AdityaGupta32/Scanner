# ══════════════════════════════════════════════════════════════
#  Dockerfile.scanner — VerseScan Scanner Engine
# ══════════════════════════════════════════════════════════════
FROM python:3.11-slim

LABEL maintainer="VerseScan Team"
LABEL description="Scanner Engine — net_red + net_blue zone"
LABEL zone="red,blue"

WORKDIR /app

# System dependencies for Playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget curl gnupg2 libnss3 libatk-bridge2.0-0 libdrm2 \
    libxkbcommon0 libgbm1 libxshmfence1 libxcomposite1 \
    libxdamage1 libxrandr2 libpango-1.0-0 libcairo2 \
    libasound2 libcups2 libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && playwright install chromium --with-deps

COPY . .

# Create reports directory
RUN mkdir -p /app/reports

EXPOSE 8000

# Run as non-root
RUN useradd -m scanner && chown -R scanner:scanner /app
USER scanner

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
